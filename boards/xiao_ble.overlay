/*
 * Seeed XIAO nRF52840
 *
 * AXA data line: a single-wire bus. D6 (TX, P1.11) and D5 (RX, P0.05) are tied
 * together and the common line goes to the level shifter. TX is open drain,
 * so the pull-ups (the AXA's own, the shifter's on the 3.3 V side) hold the
 * line high and either side can pull it low; a push-pull TX would fight the
 * AXA's replies. RX hears our own
 * transmissions too, the echo is skipped in axa.c.
 * Factory reset: connect D1 (P0.03) to GND while resetting.
 * Activity LED: the blue LED of the RGB LED (P0.06), see CONFIG_ESPAXA_ACTIVITY_LED.
 * Battery: battery bay + -- 4.7M -- D0 (P0.02, AIN0) -- 2.2M -- GND, with 100 nF
 * from D0 to GND. The XIAO's own battery sense (P0.31) measures the LiPo pad,
 * so it cannot see the AXA's battery pack.
 */

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	chosen {
		ncs,zigbee-timer = &timer2;
	};

	/*
	 * Divider ratio 2.2 / 6.9: 6.6 V (4 fresh alkaline cells) -> 2.1 V at D0,
	 * inside the 3.6 V range. It draws under 1 uA. The capacitor supplies the ADC's
	 * sampling charge, the divider alone is too high-impedance for it.
	 */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc 0>;
		output-ohms = <2200000>;
		full-ohms = <(4700000 + 2200000)>;
	};

	zephyr,user {
		reset-gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	aliases {
		axa-uart = &uart0;
		activity-led = &led2;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};

&timer2 {
	status = "okay";
};

&pinctrl {
	uart0_axa_default: uart0_axa_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 11)>;
			/*
			 * Open drain with high drive low: release for high, pull low
			 * with at least 6 mA at 0.4 V. Worst case the pin sinks about
			 * 2.1 mA (3.9 kOhm AXA pull-up at 6.6 V, plus the RX pull-up),
			 * more than standard drive guarantees (1 mA). See HARDWARE.md.
			 */
			nordic,drive-mode = <NRF_DRIVE_H0D1>;
		};

		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>;
			bias-pull-up;
		};
	};

	uart0_axa_sleep: uart0_axa_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 11)>,
				<NRF_PSEL(UART_RX, 0, 5)>;
			low-power-enable;
		};
	};
};

&uart0 {
	current-speed = <19200>;
	pinctrl-0 = <&uart0_axa_default>;
	pinctrl-1 = <&uart0_axa_sleep>;
	pinctrl-names = "default", "sleep";
};

/* The board's I2C bus uses D4/D5; D5 is the AXA RX now */
&i2c1 {
	status = "disabled";
};

/*
 * Zigbee needs two partitions on top of settings storage. Take them from the
 * end of the application area, the UF2 bootloader and SoftDevice areas stay.
 *
 * 0x00000 SoftDevice area   (156 kB, unused but kept for the UF2 bootloader)
 * 0x27000 Application       (752 kB)
 * 0xe3000 Storage           (8 kB)
 * 0xe5000 ZBOSS NVRAM       (32 kB)
 * 0xed000 ZBOSS product cfg (4 kB)
 * 0xf4000 UF2 bootloader    (48 kB)
 */
/delete-node/ &code_partition;
/delete-node/ &storage_partition;

&flash0 {
	partitions {
		code_partition: partition@27000 {
			label = "Application";
			reg = <0x00027000 0x000bc000>;
		};

		storage_partition: partition@e3000 {
			label = "Storage";
			reg = <0x000e3000 0x00002000>;
		};

		zboss_nvram: partition@e5000 {
			label = "zboss-nvram";
			reg = <0x000e5000 0x00008000>;
		};

		zboss_product_config: partition@ed000 {
			label = "zboss-product-config";
			reg = <0x000ed000 0x00001000>;
		};
	};
};
