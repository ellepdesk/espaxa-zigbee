menu "ESPAXA"

config ESPAXA_UNLOCK_DURATION_MS
	int "Time between OPEN and the chain starting to move (unlocking)"
	range 0 60000
	default 10000

config ESPAXA_OPEN_DURATION_MS
	int "Time for the chain to travel from closed to fully open"
	range 1000 600000
	default 50000

config ESPAXA_LOCK_DURATION_MS
	int "Time after reaching closed before the window is locked"
	range 0 120000
	default 30000

config ESPAXA_STATUS_INTERVAL_MS
	int "AXA STATUS poll interval while idle"
	range 10000 86400000
	default 600000
	help
	  Detects use of the buttons on the AXA itself. Every poll wakes the
	  AXA, so keep this long on batteries.

config ESPAXA_MOVING_STATUS_INTERVAL_MS
	int "AXA STATUS poll interval while moving"
	range 500 60000
	default 2000
	help
	  Detects locking before the lock timer runs out.

config ESPAXA_ACTIVITY_LED
	bool "Blink the activity LED while the AXA is busy"
	default y
	help
	  Blinks the LED with the devicetree alias activity-led (the blue
	  LED) during serial exchanges with the AXA and while it moves.
	  Off in the battery build (overlay-battery.conf); there the pin
	  stays unconfigured and the LED dark.

config ESPAXA_ZIGBEE_POLL_INTERVAL_MS
	int "Zigbee parent poll interval"
	range 250 7500
	default 5000
	help
	  How often the sleepy end device asks its parent for pending
	  commands, the worst case delay for a command from Home Assistant.
	  Parents drop buffered frames after about 7.7 s, keep this below.

endmenu

module = ESPAXA
module-str = ESPAXA
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
