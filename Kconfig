menu "ESPAXA"

config ESPAXA_UNLOCK_DURATION_MS
	int "Time between OPEN and the chain starting to move (unlocking)"
	range 0 60000
	default 10000

config ESPAXA_OPEN_DURATION_MS
	int "Time for the chain to travel from closed to fully open"
	range 1000 600000
	default 50000

config ESPAXA_LOCK_DURATION_MS
	int "Time after reaching closed before the window is locked"
	range 0 120000
	default 45000
	help
	  Upper bound only: a STATUS of 211 ends the wait early. Measured 22 to
	  32 s after the estimate reached closed (2026-10-30 and 2026-11-01).

config ESPAXA_STATUS_INTERVAL_MS
	int "AXA STATUS poll interval while idle"
	range 10000 86400000
	default 600000
	help
	  Detects use of the buttons on the AXA itself. Every poll wakes the
	  AXA, so keep this long on batteries.

config ESPAXA_BUS_POWER_SETTLE_MS
	int "Delay after switching on the AXA bus pull-up"
	range 0 1000
	default 50
	help
	  D8 switches battery voltage onto RJ12 pin 1, which feeds the
	  AXA's bus pull-up, for each serial exchange. This waits for pin 1
	  and DATA to rise before the wake-up newline.

config ESPAXA_MOVING_STATUS_INTERVAL_MS
	int "AXA STATUS poll interval while moving"
	range 500 60000
	default 2000
	help
	  Detects locking before the lock timer runs out.

config ESPAXA_ACTIVITY_LED
	bool "Blink the activity LED while the AXA is busy"
	default y
	help
	  Blinks the LED with the devicetree alias activity-led (the blue
	  LED) during serial exchanges with the AXA and while it moves.
	  Off in the battery build (overlay-battery.conf); there the pin
	  stays unconfigured and the LED dark.

config ESPAXA_BATTERY
	bool "Report the battery level"
	default y
	depends on DT_HAS_VOLTAGE_DIVIDER_ENABLED
	select SENSOR
	help
	  Measures the NiMH pack through the voltage divider on D0 (node
	  vbatt in the board overlay) and reports BatteryVoltage and
	  BatteryPercentageRemaining in a Power Configuration cluster. Without
	  the divider fitted the reading is near 0 V and both are reported as
	  unknown.

config ESPAXA_BATTERY_INTERVAL_MS
	int "Battery measurement interval"
	depends on ESPAXA_BATTERY
	range 60000 86400000
	default 3600000
	help
	  The measurement waits until the AXA has been quiet for a minute,
	  the pack sags while the motor runs.

config ESPAXA_BATTERY_CELLS
	int "NiMH cells in series"
	depends on ESPAXA_BATTERY
	range 1 8
	default 4

config ESPAXA_ZIGBEE_POLL_INTERVAL_MS
	int "Zigbee parent poll interval"
	range 250 7500
	default 5000
	help
	  How often the sleepy end device asks its parent for pending
	  commands, the worst case delay for a command from Home Assistant.
	  Parents drop buffered frames after about 7.7 s, keep this below.

endmenu

module = ESPAXA
module-str = ESPAXA
source "subsys/logging/Kconfig.template.log_config"

source "Kconfig.zephyr"
